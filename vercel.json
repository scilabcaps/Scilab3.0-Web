{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/login", "destination": "/" },
    { "source": "/signup", "destination": "/pages/signup" },
    { "source": "/forgot-password", "destination": "/pages/forgot-password" },
    { "source": "/reset-password", "destination": "/pages/reset-password" },

    { "source": "/student/dashboard", "destination": "/pages/student/student_dashboard" },
    { "source": "/student/reservation", "destination": "/pages/student/reservation_student" },
    { "source": "/student/pending", "destination": "/pages/student/student_pending" },
    { "source": "/student/approved", "destination": "/pages/student/student_approved" },
    { "source": "/student/history", "destination": "/pages/student/student_history" },
    { "source": "/student/unreturned", "destination": "/pages/student/student_unreturned" },
    { "source": "/student/upcoming", "destination": "/pages/student/student_upcoming" },
    { "source": "/student/settings", "destination": "/pages/student/settings" },

    { "source": "/professor/dashboard", "destination": "/pages/professor/professor_dashboard" },
    { "source": "/professor/reservation", "destination": "/pages/professor/professor_new_reservation" },
    { "source": "/professor/pending", "destination": "/pages/professor/professor_pending_approval" },
    { "source": "/professor/history", "destination": "/pages/professor/professor_reservation_history" },
    { "source": "/professor/my-upcoming", "destination": "/pages/professor/professor_my_upcoming" },
    { "source": "/professor/my-unreturned", "destination": "/pages/professor/professor_my_unreturned" },
    { "source": "/professor/account-approvals", "destination": "/pages/professor/account_approvals" },
    { "source": "/professor/student-approvals", "destination": "/pages/professor/student_approvals" },
    { "source": "/professor/approved", "destination": "/pages/professor/student_approved_reservation" },
    { "source": "/professor/upcoming", "destination": "/pages/professor/student_upcoming_reservations" },
    { "source": "/professor/unreturned", "destination": "/pages/professor/professor_unreturned" },
    { "source": "/professor/settings", "destination": "/pages/professor/settings" },

    { "source": "/reports/history", "destination": "/pages/history_reports" },
    { "source": "/reports/reservations", "destination": "/pages/reservation_reports" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
