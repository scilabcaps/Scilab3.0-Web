{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/signup", "destination": "/pages/signup.html" },
    { "source": "/forgot-password", "destination": "/pages/forgot-password.html" },
    { "source": "/reset-password", "destination": "/pages/reset-password.html" },

    { "source": "/student/dashboard", "destination": "/pages/student/student_dashboard.html" },
    { "source": "/student/reservation", "destination": "/pages/student/reservation_student.html" },
    { "source": "/student/pending", "destination": "/pages/student/student_pending.html" },
    { "source": "/student/approved", "destination": "/pages/student/student_approved.html" },
    { "source": "/student/history", "destination": "/pages/student/student_history.html" },
    { "source": "/student/unreturned", "destination": "/pages/student/student_unreturned.html" },
    { "source": "/student/upcoming", "destination": "/pages/student/student_upcoming.html" },
    { "source": "/student/settings", "destination": "/pages/student/settings.html" },

    { "source": "/professor/dashboard", "destination": "/pages/professor/professor_dashboard.html" },
    { "source": "/professor/reservation", "destination": "/pages/professor/professor_new_reservation.html" },
    { "source": "/professor/pending", "destination": "/pages/professor/professor_pending_approval.html" },
    { "source": "/professor/history", "destination": "/pages/professor/professor_reservation_history.html" },
    { "source": "/professor/my-upcoming", "destination": "/pages/professor/professor_my_upcoming.html" },
    { "source": "/professor/my-unreturned", "destination": "/pages/professor/professor_my_unreturned.html" },
    { "source": "/professor/account-approvals", "destination": "/pages/professor/account_approvals.html" },
    { "source": "/professor/student-approvals", "destination": "/pages/professor/student_approvals.html" },
    { "source": "/professor/approved", "destination": "/pages/professor/student_approved_reservation.html" },
    { "source": "/professor/upcoming", "destination": "/pages/professor/student_upcoming_reservations.html" },
    { "source": "/professor/unreturned", "destination": "/pages/professor/professor_unreturned.html" },
    { "source": "/professor/settings", "destination": "/pages/professor/settings.html" },

    { "source": "/reports/history", "destination": "/pages/history_reports.html" },
    { "source": "/reports/reservations", "destination": "/pages/reservation_reports.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
